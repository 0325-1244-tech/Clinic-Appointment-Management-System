{
  "name": "careconnect-web",
  "version": "2.0.0",
  "description": "CareConnect: Clinic Appointment Management System (JavaScript web version)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/api/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/domain/**\" --test-coverage-include=\"src/services/**\" --test-coverage-include=\"src/repositories/**\" --test-coverage-lines=90 --test-coverage-branches=85 \"test/unit/**/*.test.js\" \"test/api/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check:diagrams": "node scripts/check-diagrams.js",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:diagrams",
    "docs:images": "node scripts/capture-docs.js",
    "docs:word": "node scripts/build-word.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "docx": "9.15.4",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "mermaid": "11.17.2",
    "typescript": "5.9.3"
  }
}
