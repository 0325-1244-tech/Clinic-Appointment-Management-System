{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "/domain/*": [
        "./src/domain/*"
      ]
    }
  },
  "include": [
    "server.js",
    "src/**/*.js",
    "public/app/**/*.js",
    "scripts/**/*.js"
  ]
}
